# Loaded by Vite in `npm run dev` only (mode "development"); never by `vite build`.
# The web app mocks /api in the browser with MSW. Set to "false" to talk to the real API
# (apps/api on http://localhost:3000, proxied by vite.config.ts), or run
#   VITE_MOCK_API=false npm run dev -w @acme/web
# for one session. See README.md, "Running the UI without the API".
VITE_MOCK_API=true

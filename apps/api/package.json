{
  "name": "@acme/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --liftoff-only --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --liftoff-only dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/db/seed/seed.ts",
    "db:roles": "tsx --conditions=development --env-file-if-exists=../../.env src/db/roles.ts",
    "evals": "tsx --liftoff-only --conditions=development --env-file-if-exists=../../.env src/evals/run.ts"
  },
  "dependencies": {
    "@acme/shared": "^0.0.0",
    "@anthropic-ai/sdk": "1.8.0",
    "@node-rs/argon2": "2.2.2",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "libpg-query": "18.2.4",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  }
}

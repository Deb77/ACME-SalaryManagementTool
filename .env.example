# API
PORT=3000
# The API's database connection. It switches to the acme_app role on connect, so locally the
# owner URL works too. On Render: the Internal Database URL.
DATABASE_URL=
# Public URL of the app, used in invite links; also the allowed Origin for writes (CSRF check).
# APP_URL=http://localhost:5173
# Extra allowed origins, comma-separated (defaults to APP_URL and http://localhost:3000).
# APP_ORIGINS=
# Secure, __Host- session cookie. Defaults to on when NODE_ENV=production.
# COOKIE_SECURE=false
# DB_POOL_SIZE=10

# Database (see README, "Database")
# Owner role: migrations and the seed. On Render, the database's External Database URL.
DATABASE_URL_MIGRATOR=
# TLS: off for localhost, otherwise verify. Use no-verify only if Node rejects the host's certificate.
# DATABASE_SSL=verify

# Seed: demo sign-ins (docs/auth.md). The password is never committed.
# SEED_DEMO_USERS=true
# DEMO_PASSWORD=

# Tests: an empty, throwaway database the database tests may drop and recreate.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/acme_test

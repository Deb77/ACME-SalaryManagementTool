# API
PORT=3000
DATABASE_URL=
DATABASE_URL_MIGRATOR=

# Ask AI (optional: without a key and DATABASE_URL_AI, Ask AI returns 503 and the rest works)
# The reader login: same host and database as DATABASE_URL, user acme_ai_reader.
# On Render use the Internal Database URL's host here.
DATABASE_URL_AI=
# Only needed when running `npm run db:roles` (at least 16 characters).
ACME_AI_READER_PASSWORD=
ANTHROPIC_API_KEY=
AI_MODEL_PRIMARY=claude-sonnet-5-5
AI_MODEL_FALLBACK=claude-opus-5-5
# Optional overrides (defaults shown in docs/api.md):
# AI_CALL_TIMEOUT_MS=30000
# AI_CONVERSATION_TOKEN_BUDGET=150000
# AI_DAILY_TOKEN_BUDGET=1000000
# AI_MAX_TOOL_ROUNDS=6
# AI_MAX_OUTPUT_TOKENS=2000
# AI_MESSAGES_PER_MINUTE=20
# AI_MESSAGES_PER_DAY=200
# AI_SQL_ROW_CAP=200
# AI_ALERT_WINDOW_MINUTES=15
# AI_ALERT_ERROR_RATE=0.1
# AI_ALERT_FALLBACK_RATE=0.2
# AI_ALERT_DAILY_TOKENS=5000000

# Monitoring: set to serve Prometheus text at /metrics (Authorization: Bearer <token>)
METRICS_TOKEN=

# Tests and evals (throwaway databases: they are dropped and recreated)
TEST_DATABASE_URL=
EVAL_DATABASE_URL=
# EVAL_PASS_THRESHOLD=0.8
